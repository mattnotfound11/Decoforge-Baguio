# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production.

# ---- Booking notifications (Resend) -----------------------------------------
# Without RESEND_API_KEY the booking form still works: the request is accepted,
# logged, and shown a reference — it just does not send mail. Nothing is lost.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Verify your sending domain, then set BOOKING_FROM_EMAIL to an address on it.
#    Until a domain is verified, Resend only delivers to your own account email.
RESEND_API_KEY=

# Must be on a domain verified in Resend. Falls back to Resend's shared sandbox
# sender, which can only deliver to the address that owns the Resend account.
BOOKING_FROM_EMAIL="Decoforge <onboarding@resend.dev>"

# Where the team notification lands. Defaults to the address in lib/site.ts.
BOOKING_NOTIFY_EMAIL=

# ---- Live stock feed (optional) ---------------------------------------------
# Point this at an endpoint returning { "<material-slug>": <count-on-hand>, ... }
# and the catalog reads live counts instead of the baseline in lib/materials.ts.
# If the feed is slow or down, the catalog silently falls back to the baseline.
INVENTORY_URL=
INVENTORY_TOKEN=

# ---- Site ------------------------------------------------------------------
# Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://decoforge-baguio.vercel.app
